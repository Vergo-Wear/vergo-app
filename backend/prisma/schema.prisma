// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  schemas   = ["public", "auth"]
}

model AuthUser {
  id        String    @id @db.Uuid
  email     String?   @db.VarChar(255)
  phone     String?   @db.Text
  role      String?   @db.VarChar(255)
  createdAt DateTime? @map("created_at") @db.Timestamptz(6)
  profile   Profiles?

  @@map("users")
  @@schema("auth")
}

model Role {
  roleId   String     @id @default(dbgenerated("gen_random_uuid()")) @map("role_id") @db.Uuid
  roleName String     @unique @map("role_name")
  profiles Profiles[]

  @@map("role")
  @@schema("public")
}

model Profiles {
  id        String    @id @db.Uuid
  roleId    String?   @map("role_id") @db.Uuid
  username  String?   @unique
  status    String?   @default("active")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  authUser AuthUser  @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role     Role?     @relation(fields: [roleId], references: [roleId], onDelete: Restrict, onUpdate: NoAction)
  customer Customer[]
  employee Employee[]

  @@map("profiles")
  @@schema("public")
}

model Customer {
  customerId             String    @id @default(dbgenerated("gen_random_uuid()")) @map("customer_id") @db.Uuid
  profileId              String?   @map("profile_id") @db.Uuid
  firstName              String    @map("first_name")
  lastName               String    @map("last_name")
  phone                  String?
  email                  String    @unique
  defaultShippingAddress String?   @map("default_shipping_address")
  createdAt              DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  profile                Profiles? @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("customer")
  @@schema("public")
}

model Employee {
  employeeId String    @id @default(dbgenerated("gen_random_uuid()")) @map("employee_id") @db.Uuid
  profileId  String?   @map("profile_id") @db.Uuid
  branchId   String?   @map("branch_id") @db.Uuid
  firstName  String    @map("first_name")
  lastName   String    @map("last_name")
  phone      String?
  address    String?
  position   String?
  salary     Decimal?  @db.Decimal
  hireDate   DateTime? @map("hire_date") @db.Date

  profile    Profiles? @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("employee")
  @@schema("public")
}

