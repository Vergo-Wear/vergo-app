// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "auth"]
}

model AuthUser {
  id        String    @id @db.Uuid
  email     String?   @db.VarChar(255)
  phone     String?   @db.Text
  role      String?   @db.VarChar(255)
  createdAt DateTime? @map("created_at") @db.Timestamptz(6)
  profile   Profiles?

  @@map("users")
  @@schema("auth")
}

model Role {
  roleId   String     @id @default(dbgenerated("gen_random_uuid()")) @map("role_id") @db.Uuid
  roleName String     @unique @map("role_name")
  profiles Profiles[]

  @@map("role")
  @@schema("public")
}

model Profiles {
  id        String    @id @db.Uuid
  roleId    String?   @map("role_id") @db.Uuid
  username  String?   @unique
  status    String?   @default("active")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  authUser AuthUser  @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role     Role?     @relation(fields: [roleId], references: [roleId], onDelete: Restrict, onUpdate: NoAction)
  customer Customer[]
  employee Employee[]

  @@map("profiles")
  @@schema("public")
}

model Customer {
  customerId             String    @id @default(dbgenerated("gen_random_uuid()")) @map("customer_id") @db.Uuid
  profileId              String?   @map("profile_id") @db.Uuid
  firstName              String    @map("first_name")
  lastName               String    @map("last_name")
  phone                  String?
  email                  String    @unique
  defaultShippingAddress String?   @map("default_shipping_address")
  createdAt              DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  profile                Profiles? @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders                 Orders[]

  @@map("customer")
  @@schema("public")
}

model Employee {
  employeeId String    @id @default(dbgenerated("gen_random_uuid()")) @map("employee_id") @db.Uuid
  profileId  String?   @map("profile_id") @db.Uuid
  branchId   String?   @map("branch_id") @db.Uuid
  firstName  String    @map("first_name")
  lastName   String    @map("last_name")
  phone      String?
  address    String?
  position   String?
  salary     Decimal?  @db.Decimal
  hireDate   DateTime? @map("hire_date") @db.Date

  profile    Profiles? @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("employee")
  @@schema("public")
}

model Category {
  categoryId  String    @id @default(dbgenerated("gen_random_uuid()")) @map("category_id") @db.Uuid
  name        String    @unique
  description String?
  products    Product[]

  @@map("category")
  @@schema("public")
}

model Supplier {
  supplierId String    @id @default(dbgenerated("gen_random_uuid()")) @map("supplier_id") @db.Uuid
  name       String
  phone      String
  email      String
  address    String
  products   Product[]

  @@map("supplier")
  @@schema("public")
}

model Product {
  productId   String           @id @default(dbgenerated("gen_random_uuid()")) @map("product_id") @db.Uuid
  categoryId  String?          @map("category_id") @db.Uuid
  supplierId  String?          @map("supplier_id") @db.Uuid
  name        String
  description String?
  basePrice   Decimal          @map("base_price") @db.Decimal
  status      String?          @default("active")
  category    Category?        @relation(fields: [categoryId], references: [categoryId])
  supplier    Supplier?        @relation(fields: [supplierId], references: [supplierId])
  variants    ProductVariant[]

  @@map("product")
  @@schema("public")
}

model ProductVariant {
  variantId       String      @id @default(dbgenerated("gen_random_uuid()")) @map("variant_id") @db.Uuid
  productId       String?     @map("product_id") @db.Uuid
  sku             String      @unique
  size            String
  color           String
  priceAdjustment Decimal     @default(0.00) @map("price_adjustment") @db.Decimal
  product         Product?    @relation(fields: [productId], references: [productId])
  orderItems      OrderItem[]

  @@map("product_variant")
  @@schema("public")
}

model Orders {
  orderId         String                @id @default(dbgenerated("gen_random_uuid()")) @map("order_id") @db.Uuid
  customerId      String?               @map("customer_id") @db.Uuid
  employeeId      String?               @map("employee_id") @db.Uuid
  branchId        String?               @map("branch_id") @db.Uuid
  orderDate       DateTime?             @default(now()) @map("order_date") @db.Timestamptz(6)
  totalAmount     Decimal               @map("total_amount") @db.Decimal
  paymentMethod   String                @map("payment_method")
  shippingAddress String                @map("shipping_address")
  orderStatus     String?               @default("Pending Payment") @map("order_status")
  productTotal    Decimal               @default(0.00) @map("product_total") @db.Decimal
  deliveryFee     Decimal               @default(0.00) @map("delivery_fee") @db.Decimal
  codAmount       Decimal?              @default(0.00) @map("cod_amount") @db.Decimal
  
  customer        Customer?             @relation(fields: [customerId], references: [customerId])
  orderItems      OrderItem[]
  customerDetails OrderCustomerDetails?
  shippingDetails OrderShippingDetails?
  paymentProofs   PaymentProofs[]

  @@map("orders")
  @@schema("public")
}

model OrderItem {
  orderItemId String         @id @default(dbgenerated("gen_random_uuid()")) @map("order_item_id") @db.Uuid
  orderId     String?        @map("order_id") @db.Uuid
  variantId   String?        @map("variant_id") @db.Uuid
  quantity    Int
  unitPrice   Decimal        @map("unit_price") @db.Decimal
  subtotal    Decimal        @db.Decimal
  
  order       Orders?        @relation(fields: [orderId], references: [orderId])
  variant     ProductVariant? @relation(fields: [variantId], references: [variantId])

  @@map("order_item")
  @@schema("public")
}

model OrderCustomerDetails {
  detailId     String   @id @default(dbgenerated("gen_random_uuid()")) @map("detail_id") @db.Uuid
  orderId      String   @unique @map("order_id") @db.Uuid
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String
  phone        String
  customerType String   @map("customer_type")
  
  order        Orders   @relation(fields: [orderId], references: [orderId])

  @@map("order_customer_details")
  @@schema("public")
}

model OrderShippingDetails {
  shippingId   String  @id @default(dbgenerated("gen_random_uuid()")) @map("shipping_id") @db.Uuid
  orderId      String  @unique @map("order_id") @db.Uuid
  receiverName String  @map("receiver_name")
  phone        String
  addressLine1 String  @map("address_line_1")
  addressLine2 String? @map("address_line_2")
  city         String
  district     String
  postalCode   String? @map("postal_code")
  deliveryNote String? @map("delivery_note")
  
  order        Orders  @relation(fields: [orderId], references: [orderId])

  @@map("order_shipping_details")
  @@schema("public")
}

model PaymentProofs {
  proofId     String    @id @default(dbgenerated("gen_random_uuid()")) @map("proof_id") @db.Uuid
  orderId     String    @map("order_id") @db.Uuid
  receiptUrl  String?   @map("receipt_url")
  uploadedAt  DateTime? @map("uploaded_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  status      String    @default("Pending Upload")
  adminNotes  String?   @map("admin_notes")
  
  order       Orders    @relation(fields: [orderId], references: [orderId])

  @@map("payment_proofs")
  @@schema("public")
}

