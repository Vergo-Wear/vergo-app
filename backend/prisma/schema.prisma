// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "auth"]
}

model AuthUser {
  id        String    @id @db.Uuid
  email     String?   @db.VarChar(255)
  phone     String?   @db.Text
  role      String?   @db.VarChar(255)
  createdAt DateTime? @map("created_at") @db.Timestamptz(6)
  profile   Profiles?

  @@map("users")
  @@schema("auth")
}

model Role {
  roleId   String     @id @default(dbgenerated("gen_random_uuid()")) @map("role_id") @db.Uuid
  roleName String     @unique @map("role_name")
  profiles Profiles[]

  @@map("role")
  @@schema("public")
}

model Profiles {
  id        String    @id @db.Uuid
  roleId    String?   @map("role_id") @db.Uuid
  username  String?   @unique
  status    String?   @default("active")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  authUser AuthUser   @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role     Role?      @relation(fields: [roleId], references: [roleId], onDelete: Restrict, onUpdate: NoAction)
  customer Customer[]
  employee Employee[]

  @@map("profiles")
  @@schema("public")
}

model Customer {
  customerId             String    @id @default(dbgenerated("gen_random_uuid()")) @map("customer_id") @db.Uuid
  profileId              String?   @map("profile_id") @db.Uuid
  firstName              String    @map("first_name")
  lastName               String    @map("last_name")
  phone                  String?
  email                  String    @unique
  defaultShippingAddress String?   @map("default_shipping_address")
  createdAt              DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profiles? @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("customer")
  @@schema("public")
}

model Employee {
  employeeId String    @id @default(dbgenerated("gen_random_uuid()")) @map("employee_id") @db.Uuid
  profileId  String?   @map("profile_id") @db.Uuid
  branchId   String?   @map("branch_id") @db.Uuid
  firstName  String    @map("first_name")
  lastName   String    @map("last_name")
  phone      String?
  address    String?
  position   String?
  salary     Decimal?  @db.Decimal
  hireDate   DateTime? @map("hire_date") @db.Date

  profile Profiles? @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("employee")
  @@schema("public")
}

model Category {
  categoryId  String    @id @default(dbgenerated("gen_random_uuid()")) @map("category_id") @db.Uuid
  name        String    @unique
  description String?
  products    Product[]

  @@map("category")
  @@schema("public")
}

model Supplier {
  supplierId String    @id @default(dbgenerated("gen_random_uuid()")) @map("supplier_id") @db.Uuid
  name       String
  phone      String
  email      String
  address    String
  products   Product[]

  @@map("supplier")
  @@schema("public")
}

model Product {
  productId   String  @id @default(dbgenerated("gen_random_uuid()")) @map("product_id") @db.Uuid
  categoryId  String? @map("category_id") @db.Uuid
  supplierId  String? @map("supplier_id") @db.Uuid
  name        String
  description String?
  basePrice   Decimal @map("base_price") @db.Decimal
  status      String? @default("active")

  category Category?        @relation(fields: [categoryId], references: [categoryId], onDelete: NoAction, onUpdate: NoAction)
  supplier Supplier?        @relation(fields: [supplierId], references: [supplierId], onDelete: NoAction, onUpdate: NoAction)
  variants ProductVariant[]

  @@map("product")
  @@schema("public")
}

model ProductVariant {
  variantId       String   @id @default(dbgenerated("gen_random_uuid()")) @map("variant_id") @db.Uuid
  productId       String?  @map("product_id") @db.Uuid
  sku             String   @unique
  size            String
  color           String
  priceAdjustment Decimal? @default(0.00) @map("price_adjustment") @db.Decimal

  product   Product?    @relation(fields: [productId], references: [productId], onDelete: NoAction, onUpdate: NoAction)
  inventory Inventory[]
  images    Images[]

  @@map("product_variant")
  @@schema("public")
}

model Inventory {
  inventoryId      String    @id @default(dbgenerated("gen_random_uuid()")) @map("inventory_id") @db.Uuid
  variantId        String?   @map("variant_id") @db.Uuid
  branchId         String?   @map("branch_id") @db.Uuid
  quantity         Int?      @default(0)
  reorderLevel     Int?      @default(10) @map("reorder_level")
  lastUpdated      DateTime? @default(now()) @map("last_updated") @db.Timestamptz(6)
  reservedQuantity Int?      @default(0) @map("reserved_quantity")

  variant ProductVariant? @relation(fields: [variantId], references: [variantId], onDelete: NoAction, onUpdate: NoAction)

  @@map("inventory")
  @@schema("public")
}

model Images {
  id        BigInt    @id @default(autoincrement())
  imageUrl  String    @map("image_url")
  title     String?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  variantId String?   @map("variant_id") @db.Uuid

  variant ProductVariant? @relation(fields: [variantId], references: [variantId], onDelete: NoAction, onUpdate: NoAction)

  @@map("images")
  @@schema("public")
}
