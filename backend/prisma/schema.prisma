// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "auth"]
}

model AuthUser {
  id        String    @id @db.Uuid
  email     String?   @db.VarChar(255)
  phone     String?   @db.Text
  role      String?   @db.VarChar(255)
  createdAt DateTime? @map("created_at") @db.Timestamptz(6)
  profile   Profiles?

  @@map("users")
  @@schema("auth")
}

model Role {
  roleId   String     @id @default(dbgenerated("gen_random_uuid()")) @map("role_id") @db.Uuid
  roleName String     @unique @map("role_name")
  profiles Profiles[]

  @@map("role")
  @@schema("public")
}

model Profiles {
  id         String    @id @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  username   String?   @unique
  status             String?   @default("active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt         DateTime? @map("last_seen_at") @db.Timestamptz(6)

  authUser              AuthUser          @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role                  Role              @relation(fields: [roleId], references: [roleId], onDelete: Restrict, onUpdate: NoAction)
  customer              Customer?
  employee              Employee?         @relation("EmployeeProfile")
  createdEmployees      Employee[]        @relation("EmployeeCreatedBy")
  reviewedCheckouts     PendingCheckout[] @relation("PendingCheckoutReviewer")
  reviewedPaymentProofs PaymentProof[]    @relation("PaymentProofReviewer")
  notifications         Notification[]

  @@map("profiles")
  @@schema("public")
}

model Customer {
  customerId String    @id @default(dbgenerated("gen_random_uuid()")) @map("customer_id") @db.Uuid
  profileId  String    @unique @map("profile_id") @db.Uuid
  firstName  String    @map("first_name")
  lastName   String    @map("last_name")
  phone      String?   @map("contact_phone")
  email      String    @unique @map("contact_email")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  profile          Profiles          @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders           Orders[]
  cart             Cart?
  reviews          Review[]
  addresses        UserAddress[]
  pendingCheckouts PendingCheckout[]

  @@map("customer")
  @@schema("public")
}

model UserAddress {
  addressId    String    @id @default(dbgenerated("gen_random_uuid()")) @map("address_id") @db.Uuid
  customerId   String    @map("customer_id") @db.Uuid
  receiverName String    @map("receiver_name")
  phone        String
  addressLine1 String    @map("address_line_1")
  addressLine2 String?   @map("address_line_2")
  city         String
  district     String
  postalCode   String?   @map("postal_code")
  isPrimary    Boolean   @default(false) @map("is_primary")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [customerId], onDelete: Cascade)

  @@index([customerId])
  @@map("user_addresses")
  @@schema("public")
}

model Cart {
  cartId     String    @id @default(dbgenerated("gen_random_uuid()")) @map("cart_id") @db.Uuid
  customerId String    @unique @map("customer_id") @db.Uuid
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer   @relation(fields: [customerId], references: [customerId], onDelete: Cascade)
  items    CartItem[]

  @@map("cart")
  @@schema("public")
}

model CartItem {
  cartItemId String @id @default(dbgenerated("gen_random_uuid()")) @map("cart_item_id") @db.Uuid
  cartId     String @map("cart_id") @db.Uuid
  variantId  String @map("variant_id") @db.Uuid
  quantity   Int    @default(1)

  cart    Cart           @relation(fields: [cartId], references: [cartId], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [variantId])

  @@unique([cartId, variantId])
  @@map("cart_item")
  @@schema("public")
}

model Employee {
  employeeId          String    @id @default(dbgenerated("gen_random_uuid()")) @map("employee_id") @db.Uuid
  profileId           String    @unique @map("profile_id") @db.Uuid
  branchId            String?   @map("branch_id") @db.Uuid
  createdByProfileId  String?   @map("created_by_profile_id") @db.Uuid
  firstName           String    @map("first_name")
  lastName            String    @map("last_name")
  phone               String?
  address             String?
  position            String?
  salary              Decimal?  @db.Decimal
  commissionPerParcel Decimal   @default(0) @map("commission_per_parcel") @db.Decimal
  hireDate            DateTime? @map("hire_date") @db.Date
  availabilityStatus  String    @default("OFF_DUTY") @map("availability_status")

  profile        Profiles             @relation("EmployeeProfile", fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdBy      Profiles?            @relation("EmployeeCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)
  branch         Branch?              @relation(fields: [branchId], references: [branchId])
  assignedOrders Orders[]             @relation("OrderAssignedEmployee")
  attendance     Attendance[]
  salaryRecords  SalaryRecord[]
  commissions    EmployeeCommission[]
  purchaseOrders PurchaseOrder[]

  submittedDeliveries Delivery[]              @relation("DeliverySubmittedBy")
  requestedPickups    CourierPickupRequest[]  @relation("PickupRequestedBy")

  @@map("employee")
  @@schema("public")
}

model Branch {
  branchId String @id @default(dbgenerated("gen_random_uuid()")) @map("branch_id") @db.Uuid
  name     String
  address  String
  phone    String

  employees       Employee[]
  inventory       Inventory[]
  orders          Orders[]
  shipperProfiles CourierShipperProfile[]
  pickupRequests  CourierPickupRequest[]

  @@map("branch")
  @@schema("public")
}

model Category {
  categoryId  String    @id @default(dbgenerated("gen_random_uuid()")) @map("category_id") @db.Uuid
  name        String    @unique
  description String?
  products    Product[]

  @@map("category")
  @@schema("public")
}

model Color {
  colorId      String           @id @default(dbgenerated("gen_random_uuid()")) @map("color_id") @db.Uuid
  name         String
  hexCode      String?          @map("hex_code")
  imageUrl     String?          @map("image_url")
  displayOrder Int              @default(0) @map("display_order")
  status       String           @default("Active")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  variants     ProductVariant[]

  @@index([status, displayOrder])
  @@map("color")
  @@schema("public")
}

model Size {
  sizeId       String           @id @default(dbgenerated("gen_random_uuid()")) @map("size_id") @db.Uuid
  name         String
  displayOrder Int              @default(0) @map("display_order")
  status       String           @default("Active")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  variants     ProductVariant[]

  @@index([status, displayOrder])
  @@map("size")
  @@schema("public")
}

model Supplier {
  supplierId     String          @id @default(dbgenerated("gen_random_uuid()")) @map("supplier_id") @db.Uuid
  name           String
  phone          String
  email          String
  address        String
  status         String          @default("Active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@map("supplier")
  @@schema("public")
}

model Product {
  productId   String   @id @default(dbgenerated("gen_random_uuid()")) @map("product_id") @db.Uuid
  categoryId  String?  @map("category_id") @db.Uuid
  supplierId  String?  @map("supplier_id") @db.Uuid
  name        String
  description String?
  basePrice   Decimal  @map("base_price") @db.Decimal
  status      String   @default("hidden")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  category Category?        @relation(fields: [categoryId], references: [categoryId], onDelete: NoAction, onUpdate: NoAction)
  supplier Supplier?        @relation(fields: [supplierId], references: [supplierId], onDelete: NoAction, onUpdate: NoAction)
  variants ProductVariant[]
  reviews  Review[]

  @@index([createdAt])
  @@map("product")
  @@schema("public")
}

model Review {
  reviewId    String   @id @default(dbgenerated("gen_random_uuid()")) @map("review_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  orderItemId String   @unique @map("order_item_id") @db.Uuid
  rating      Int
  comment     String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product   Product       @relation(fields: [productId], references: [productId], onDelete: Cascade)
  customer  Customer      @relation(fields: [customerId], references: [customerId], onDelete: Cascade)
  orderItem OrderItem     @relation(fields: [orderItemId], references: [orderItemId], onDelete: Restrict)
  images    ReviewImage[]

  @@unique([productId, customerId])
  @@map("review")
  @@schema("public")
}

model ReviewImage {
  reviewImageId String   @id @default(dbgenerated("gen_random_uuid()")) @map("review_image_id") @db.Uuid
  reviewId      String   @map("review_id") @db.Uuid
  imageUrl      String   @map("image_url")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  review Review @relation(fields: [reviewId], references: [reviewId], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_image")
  @@schema("public")
}

model ProductVariant {
  variantId       String   @id @default(dbgenerated("gen_random_uuid()")) @map("variant_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  colorId         String   @map("color_id") @db.Uuid
  sizeId          String   @map("size_id") @db.Uuid
  sku             String   @unique
  status          String   @default("show")
  priceAdjustment Decimal? @default(0.00) @map("price_adjustment") @db.Decimal

  product              Product               @relation(fields: [productId], references: [productId], onDelete: NoAction, onUpdate: NoAction)
  color                Color                 @relation(fields: [colorId], references: [colorId], onDelete: Restrict, onUpdate: Cascade)
  size                 Size                  @relation(fields: [sizeId], references: [sizeId], onDelete: Restrict, onUpdate: Cascade)
  inventory            Inventory[]
  images               Images[]
  orderItems           OrderItem[]
  cartItems            CartItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  pendingCheckoutItems PendingCheckoutItem[]

  @@unique([productId, sizeId, colorId])
  @@index([productId, status])
  @@map("product_variant")
  @@schema("public")
}

model Inventory {
  inventoryId  String    @id @default(dbgenerated("gen_random_uuid()")) @map("inventory_id") @db.Uuid
  variantId    String    @map("variant_id") @db.Uuid
  branchId     String?   @map("branch_id") @db.Uuid
  quantity     Int       @default(0)
  reorderLevel Int?      @default(10) @map("reorder_level")
  lastUpdated  DateTime? @default(now()) @map("last_updated") @db.Timestamptz(6)

  variant           ProductVariant        @relation(fields: [variantId], references: [variantId], onDelete: NoAction, onUpdate: NoAction)
  branch            Branch?               @relation(fields: [branchId], references: [branchId])
  stockReservations StockReservation[]
  commitments       InventoryCommitment[]

  @@map("inventory")
  @@schema("public")
}

model Images {
  id        BigInt    @id @default(autoincrement())
  imageUrl  String    @map("image_url")
  title     String?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  variantId String    @map("variant_id") @db.Uuid

  variant ProductVariant @relation(fields: [variantId], references: [variantId], onDelete: NoAction, onUpdate: NoAction)

  @@map("images")
  @@schema("public")
}

model Orders {
  orderId       String    @id @default(dbgenerated("gen_random_uuid()")) @map("order_id") @db.Uuid
  checkoutId    String    @unique @map("checkout_id") @db.Uuid
  customerId    String?   @map("customer_id") @db.Uuid
  employeeId    String?   @map("employee_id") @db.Uuid
  branchId      String?   @map("branch_id") @db.Uuid
  orderDate     DateTime? @default(now()) @map("order_date") @db.Timestamptz(6)
  totalAmount   Decimal   @map("total_amount") @db.Decimal
  paymentMethod String    @map("payment_method")
  orderStatus   String    @default("Ready to Process") @map("order_status")
  productTotal  Decimal   @default(0.00) @map("product_total") @db.Decimal
  deliveryFee   Decimal   @default(0.00) @map("delivery_fee") @db.Decimal
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  claimedAt     DateTime? @map("claimed_at") @db.Timestamptz(6)
  preparingAt   DateTime? @map("preparing_at") @db.Timestamptz(6)
  parcelReadyAt DateTime? @map("parcel_ready_at") @db.Timestamptz(6)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz(6)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)

  checkout         PendingCheckout       @relation(fields: [checkoutId], references: [checkoutId])
  customer         Customer?             @relation(fields: [customerId], references: [customerId])
  assignedEmployee Employee?             @relation("OrderAssignedEmployee", fields: [employeeId], references: [employeeId])
  branch           Branch?               @relation(fields: [branchId], references: [branchId])
  orderItems       OrderItem[]
  customerDetails  OrderCustomerDetails?
  shippingDetails  OrderShippingDetails?
  notifications    Notification[]
  delivery         Delivery?
  commission       EmployeeCommission?

  @@index([customerId])
  @@map("orders")
  @@schema("public")
}

model Attendance {
  attendanceId String    @id @default(dbgenerated("gen_random_uuid()")) @map("attendance_id") @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  date         DateTime  @db.Date
  checkIn      DateTime? @map("check_in") @db.Timestamptz(6)
  checkOut     DateTime? @map("check_out") @db.Timestamptz(6)
  status       String?

  employee Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Restrict)

  @@map("attendance")
  @@schema("public")
}

model SalaryRecord {
  salaryId        String    @id @default(dbgenerated("gen_random_uuid()")) @map("salary_id") @db.Uuid
  employeeId      String    @map("employee_id") @db.Uuid
  month           DateTime  @db.Date
  basicSalary     Decimal   @map("basic_salary") @db.Decimal
  commissionTotal Decimal   @default(0) @map("commission_total") @db.Decimal
  bonus           Decimal   @default(0.00) @db.Decimal
  deduction       Decimal   @default(0.00) @db.Decimal
  netSalary       Decimal   @map("net_salary") @db.Decimal
  paymentStatus   String    @default("Pending") @map("payment_status")
  calculatedAt    DateTime  @default(now()) @map("calculated_at") @db.Timestamptz(6)
  paidAt          DateTime? @map("paid_at") @db.Timestamptz(6)

  employee    Employee             @relation(fields: [employeeId], references: [employeeId], onDelete: Restrict)
  commissions EmployeeCommission[]

  @@unique([employeeId, month])
  @@map("salary_record")
  @@schema("public")
}

model Delivery {
  deliveryId            String    @id @default(dbgenerated("gen_random_uuid()")) @map("delivery_id") @db.Uuid
  orderId               String    @map("order_id") @db.Uuid
  deliveryStatus        String    @default("Pending") @map("delivery_status")
  deliveredAt           DateTime? @map("delivered_at") @db.Timestamptz(6)
  courierName           String    @default("Citypak") @map("courier_name")
  courierReference      String?   @map("courier_reference")
  waybillNumber         String?   @map("waybill_number")
  submissionStatus      String    @default("Pending") @map("submission_status")
  submittedAt           DateTime? @map("submitted_at") @db.Timestamptz(6)
  failureReason         String?   @map("failure_reason")
  shipmentReference     String?   @map("shipment_reference")
  externalOrderId       String?   @map("external_order_id")
  packageWeightGrams    Int?      @map("package_weight_grams")
  numberOfPieces        Int       @default(1) @map("number_of_pieces")
  packageDescription    String?   @map("package_description")
  codAmount             Decimal   @default(0) @map("cod_amount") @db.Decimal
  courierStatus         String?   @map("courier_status")
  courierStatusType     String?   @map("courier_status_type")
  lastTrackingSyncAt    DateTime? @map("last_tracking_sync_at") @db.Timestamptz(6)
  podImageUrl           String?   @map("pod_image_url")
  receiverName          String?   @map("receiver_name")
  receiverNic           String?   @map("receiver_nic")
  submittedByEmployeeId String?   @map("submitted_by_employee_id") @db.Uuid
  packageLengthCm       Decimal?  @map("package_length_cm") @db.Decimal
  packageWidthCm        Decimal?  @map("package_width_cm") @db.Decimal
  packageHeightCm       Decimal?  @map("package_height_cm") @db.Decimal
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order            Orders                  @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  submittedBy      Employee?               @relation("DeliverySubmittedBy", fields: [submittedByEmployeeId], references: [employeeId], onDelete: SetNull)
  waybills         DeliveryWaybill[]
  trackingEvents   DeliveryTrackingEvent[]
  pickupDeliveries CourierPickupDelivery[]

  @@unique([orderId])
  @@map("delivery")
  @@schema("public")
}

model CourierShipperProfile {
  profileId        String   @id @default(dbgenerated("gen_random_uuid()")) @map("profile_id") @db.Uuid
  courierName      String   @default("Citypak") @map("courier_name")
  branchId         String?  @map("branch_id") @db.Uuid
  shipperName      String   @map("shipper_name")
  addressLine1     String   @map("address_line_1")
  addressLine2     String?  @map("address_line_2")
  addressLine3     String?  @map("address_line_3")
  addressLine4City String   @map("address_line_4_city")
  contactName      String   @map("contact_name")
  contactNumber1   String   @map("contact_number_1")
  contactNumber2   String?  @map("contact_number_2")
  isDefault        Boolean  @default(true) @map("is_default")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch Branch? @relation(fields: [branchId], references: [branchId], onDelete: SetNull)

  @@map("courier_shipper_profile")
  @@schema("public")
}

model DeliveryWaybill {
  waybillId            String   @id @default(dbgenerated("gen_random_uuid()")) @map("waybill_id") @db.Uuid
  deliveryId           String   @map("delivery_id") @db.Uuid
  trackingNumber       String   @unique @map("tracking_number")
  reference            String?
  deliveryFacilityCode String?  @map("delivery_facility_code")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  delivery       Delivery                @relation(fields: [deliveryId], references: [deliveryId], onDelete: Cascade)
  trackingEvents DeliveryTrackingEvent[]

  @@index([deliveryId])
  @@map("delivery_waybill")
  @@schema("public")
}

model DeliveryTrackingEvent {
  eventId        String   @id @default(dbgenerated("gen_random_uuid()")) @map("event_id") @db.Uuid
  deliveryId     String   @map("delivery_id") @db.Uuid
  waybillId      String?  @map("waybill_id") @db.Uuid
  trackingNumber String   @map("tracking_number")
  status         String
  statusType     String?  @map("status_type")
  statusCode     String?  @map("status_code")
  description    String?
  reason         String?
  location       String?
  eventAt        DateTime @map("event_at") @db.Timestamptz(6)
  source         String   @default("TRACKING_API")
  externalItemId Int?     @map("external_item_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  delivery Delivery         @relation(fields: [deliveryId], references: [deliveryId], onDelete: Cascade)
  waybill  DeliveryWaybill? @relation(fields: [waybillId], references: [waybillId], onDelete: SetNull)

  @@unique([trackingNumber, status, eventAt])
  @@index([deliveryId])
  @@map("delivery_tracking_event")
  @@schema("public")
}

model CourierPickupRequest {
  pickupRequestId             String   @id @default(dbgenerated("gen_random_uuid()")) @map("pickup_request_id") @db.Uuid
  courierName                 String   @default("Citypak") @map("courier_name")
  externalPickupId            Int?     @map("external_pickup_id")
  requestedByEmployeeId       String?  @map("requested_by_employee_id") @db.Uuid
  branchId                    String?  @map("branch_id") @db.Uuid
  pickupAddressLine1          String   @map("pickup_address_line_1")
  pickupAddressLine2          String?  @map("pickup_address_line_2")
  pickupAddressLine3          String?  @map("pickup_address_line_3")
  pickupAddressLine4City      String   @map("pickup_address_line_4_city")
  pickupContactPerson         String   @map("pickup_contact_person")
  pickupContactNumber1        String   @map("pickup_contact_number_1")
  estimatedPickupWeightGrams Int      @map("estimated_pickup_weight_grams")
  estimatedWaybillCount       Int      @map("estimated_waybill_count")
  pickupFromDatetime          DateTime @map("pickup_from_datetime") @db.Timestamptz(6)
  pickupToDatetime            DateTime @map("pickup_to_datetime") @db.Timestamptz(6)
  status                      String   @default("Requested")
  submittedAt                 DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
  failureReason               String?  @map("failure_reason")
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  deliveries  CourierPickupDelivery[]
  requestedBy Employee?               @relation("PickupRequestedBy", fields: [requestedByEmployeeId], references: [employeeId], onDelete: SetNull)
  branch      Branch?                 @relation(fields: [branchId], references: [branchId], onDelete: SetNull)

  @@map("courier_pickup_request")
  @@schema("public")
}

model CourierPickupDelivery {
  pickupRequestId String   @map("pickup_request_id") @db.Uuid
  deliveryId      String   @map("delivery_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  pickupRequest CourierPickupRequest @relation(fields: [pickupRequestId], references: [pickupRequestId], onDelete: Cascade)
  delivery      Delivery             @relation(fields: [deliveryId], references: [deliveryId], onDelete: Cascade)

  @@id([pickupRequestId, deliveryId])
  @@map("courier_pickup_delivery")
  @@schema("public")
}

model PurchaseOrder {
  purchaseOrderId String    @id @default(dbgenerated("gen_random_uuid()")) @map("purchase_order_id") @db.Uuid
  supplierId      String    @map("supplier_id") @db.Uuid
  employeeId      String?   @map("employee_id") @db.Uuid
  orderDate       DateTime? @default(now()) @map("order_date") @db.Timestamptz(6)
  status          String?   @default("requested")
  totalAmount     Decimal   @map("total_amount") @db.Decimal

  supplier Supplier            @relation(fields: [supplierId], references: [supplierId], onDelete: Restrict)
  employee Employee?           @relation(fields: [employeeId], references: [employeeId])
  items    PurchaseOrderItem[]

  @@map("purchase_order")
  @@schema("public")
}

model PurchaseOrderItem {
  poItemId        String  @id @default(dbgenerated("gen_random_uuid()")) @map("po_item_id") @db.Uuid
  purchaseOrderId String  @map("purchase_order_id") @db.Uuid
  variantId       String  @map("variant_id") @db.Uuid
  quantity        Int
  costPrice       Decimal @map("cost_price") @db.Decimal

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [purchaseOrderId], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [variantId], onDelete: Restrict)

  @@unique([purchaseOrderId, variantId])
  @@map("purchase_order_item")
  @@schema("public")
}

model DeliveryFeeRule {
  ruleId    String  @id @default(dbgenerated("gen_random_uuid()")) @map("rule_id") @db.Uuid
  district  String  @unique
  feeAmount Decimal @map("fee_amount") @db.Decimal

  @@map("delivery_fee_rules")
  @@schema("public")
}

model OrderItem {
  orderItemId String  @id @default(dbgenerated("gen_random_uuid()")) @map("order_item_id") @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  variantId   String  @map("variant_id") @db.Uuid
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal
  subtotal    Decimal @db.Decimal

  order                Orders                @relation(fields: [orderId], references: [orderId])
  variant              ProductVariant        @relation(fields: [variantId], references: [variantId])
  inventoryCommitments InventoryCommitment[]
  review               Review?

  @@unique([orderId, variantId])
  @@map("order_item")
  @@schema("public")
}

model StockReservation {
  reservationId String    @id @default(dbgenerated("gen_random_uuid()")) @map("reservation_id") @db.Uuid
  checkoutId    String    @map("checkout_id") @db.Uuid
  inventoryId   String    @map("inventory_id") @db.Uuid
  quantity      Int
  status        String    @default("Active")
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  checkout  PendingCheckout @relation(fields: [checkoutId], references: [checkoutId], onDelete: Cascade)
  inventory Inventory       @relation(fields: [inventoryId], references: [inventoryId])

  @@unique([checkoutId, inventoryId])
  @@index([checkoutId])
  @@index([inventoryId])
  @@index([status, expiresAt], map: "stock_reservation_expiry_index")
  @@map("stock_reservation")
  @@schema("public")
}

model PendingCheckout {
  checkoutId          String    @id @default(dbgenerated("gen_random_uuid()")) @map("checkout_id") @db.Uuid
  customerId          String?   @map("customer_id") @db.Uuid
  paymentMethod       String    @map("payment_method")
  status              String
  productTotal        Decimal   @default(0) @map("product_total") @db.Decimal
  deliveryFee         Decimal   @map("delivery_fee") @db.Decimal
  totalAmount         Decimal   @default(0) @map("total_amount") @db.Decimal
  expiresAt           DateTime? @map("expires_at") @db.Timestamptz(6)
  reviewedByProfileId String?   @map("reviewed_by_profile_id") @db.Uuid
  reviewedAt          DateTime? @map("reviewed_at") @db.Timestamptz(6)
  adminNotes          String?   @map("admin_notes")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer        Customer?                       @relation(fields: [customerId], references: [customerId], onDelete: Cascade)
  reviewer        Profiles?                       @relation("PendingCheckoutReviewer", fields: [reviewedByProfileId], references: [id], onDelete: SetNull)
  order           Orders?
  items           PendingCheckoutItem[]
  customerDetails PendingCheckoutCustomerDetails?
  shippingDetails PendingCheckoutShippingDetails?
  paymentProof    PaymentProof?
  reservations    StockReservation[]
  notifications   Notification[]

  @@index([customerId, status])
  @@index([status, createdAt])
  @@map("pending_checkout")
  @@schema("public")
}

model PendingCheckoutItem {
  checkoutItemId String  @id @default(dbgenerated("gen_random_uuid()")) @map("checkout_item_id") @db.Uuid
  checkoutId     String  @map("checkout_id") @db.Uuid
  variantId      String  @map("variant_id") @db.Uuid
  quantity       Int
  unitPrice      Decimal @map("unit_price") @db.Decimal

  checkout PendingCheckout @relation(fields: [checkoutId], references: [checkoutId], onDelete: Cascade)
  variant  ProductVariant  @relation(fields: [variantId], references: [variantId])

  @@unique([checkoutId, variantId])
  @@index([checkoutId])
  @@map("pending_checkout_item")
  @@schema("public")
}

model PendingCheckoutCustomerDetails {
  detailId   String @id @default(dbgenerated("gen_random_uuid()")) @map("detail_id") @db.Uuid
  checkoutId String @unique @map("checkout_id") @db.Uuid
  firstName  String @map("first_name")
  lastName   String @map("last_name")
  email      String
  phone      String

  checkout PendingCheckout @relation(fields: [checkoutId], references: [checkoutId], onDelete: Cascade)

  @@map("pending_checkout_customer_details")
  @@schema("public")
}

model PendingCheckoutShippingDetails {
  shippingId   String  @id @default(dbgenerated("gen_random_uuid()")) @map("shipping_id") @db.Uuid
  checkoutId   String  @unique @map("checkout_id") @db.Uuid
  receiverName String  @map("receiver_name")
  phone        String
  addressLine1 String  @map("address_line_1")
  addressLine2 String? @map("address_line_2")
  city         String
  district     String
  postalCode   String? @map("postal_code")
  deliveryNote String? @map("delivery_note")

  checkout PendingCheckout @relation(fields: [checkoutId], references: [checkoutId], onDelete: Cascade)

  @@map("pending_checkout_shipping_details")
  @@schema("public")
}

model PaymentProof {
  paymentProofId      String    @id @default(dbgenerated("gen_random_uuid()")) @map("payment_proof_id") @db.Uuid
  checkoutId          String    @unique @map("checkout_id") @db.Uuid
  fileUrl             String    @map("file_url")
  fileName            String?   @map("file_name")
  mimeType            String?   @map("mime_type")
  fileSizeBytes       Int?      @map("file_size_bytes")
  storagePublicId     String?   @map("storage_public_id")
  status              String    @default("Pending Verification")
  uploadedAt          DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  reviewedByProfileId String?   @map("reviewed_by_profile_id") @db.Uuid
  reviewedAt          DateTime? @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason     String?   @map("rejection_reason")

  checkout PendingCheckout @relation(fields: [checkoutId], references: [checkoutId], onDelete: Cascade)
  reviewer Profiles?       @relation("PaymentProofReviewer", fields: [reviewedByProfileId], references: [id], onDelete: SetNull)

  @@map("payment_proof")
  @@schema("public")
}

model InventoryCommitment {
  commitmentId  String    @id @default(dbgenerated("gen_random_uuid()")) @map("commitment_id") @db.Uuid
  orderItemId   String    @map("order_item_id") @db.Uuid
  inventoryId   String    @map("inventory_id") @db.Uuid
  quantity      Int
  status        String    @default("Committed")
  committedAt   DateTime  @default(now()) @map("committed_at") @db.Timestamptz(6)
  restoredAt    DateTime? @map("restored_at") @db.Timestamptz(6)
  restoreReason String?   @map("restore_reason")

  orderItem OrderItem @relation(fields: [orderItemId], references: [orderItemId])
  inventory Inventory @relation(fields: [inventoryId], references: [inventoryId])

  @@unique([orderItemId, inventoryId])
  @@index([orderItemId], map: "inventory_commitment_order_item_id_idx")
  @@index([inventoryId], map: "inventory_commitment_inventory_id_idx")
  @@index([status])
  @@map("inventory_commitment")
  @@schema("public")
}

model OrderCustomerDetails {
  detailId  String    @id @default(dbgenerated("gen_random_uuid()")) @map("detail_id") @db.Uuid
  orderId   String    @unique @map("order_id") @db.Uuid
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  email     String
  phone     String
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  order Orders @relation(fields: [orderId], references: [orderId])

  @@map("order_customer_details")
  @@schema("public")
}

model OrderShippingDetails {
  shippingId   String    @id @default(dbgenerated("gen_random_uuid()")) @map("shipping_id") @db.Uuid
  orderId      String    @unique @map("order_id") @db.Uuid
  receiverName String    @map("receiver_name")
  phone        String
  addressLine1 String    @map("address_line_1")
  addressLine2 String?   @map("address_line_2")
  city         String
  district     String
  postalCode   String?   @map("postal_code")
  deliveryNote String?   @map("delivery_note")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  order Orders @relation(fields: [orderId], references: [orderId])

  @@map("order_shipping_details")
  @@schema("public")
}

model Notification {
  notificationId     String    @id @default(dbgenerated("gen_random_uuid()")) @map("notification_id") @db.Uuid
  recipientProfileId String?   @map("recipient_profile_id") @db.Uuid
  orderId            String?   @map("order_id") @db.Uuid
  checkoutId         String?   @map("checkout_id") @db.Uuid
  type               String
  title              String
  message            String
  channel            String    @default("IN_APP")
  status             String    @default("Pending")
  sentAt             DateTime? @map("sent_at") @db.Timestamptz(6)
  isRead             Boolean   @default(false) @map("is_read")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  recipient Profiles?        @relation(fields: [recipientProfileId], references: [id], onDelete: Cascade)
  order     Orders?          @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  checkout  PendingCheckout? @relation(fields: [checkoutId], references: [checkoutId], onDelete: Cascade)

  @@index([recipientProfileId, isRead])
  @@index([orderId])
  @@index([checkoutId])
  @@map("notification")
  @@schema("public")
}

model EmployeeCommission {
  commissionId     String    @id @default(dbgenerated("gen_random_uuid()")) @map("commission_id") @db.Uuid
  employeeId       String    @map("employee_id") @db.Uuid
  orderId          String    @unique @map("order_id") @db.Uuid
  rateUsed         Decimal   @map("rate_used") @db.Decimal
  commissionAmount Decimal   @map("commission_amount") @db.Decimal
  status           String    @default("Approved")
  salaryId         String?   @map("salary_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  paidAt           DateTime? @map("paid_at") @db.Timestamptz(6)

  employee Employee      @relation(fields: [employeeId], references: [employeeId], onDelete: Restrict)
  order    Orders        @relation(fields: [orderId], references: [orderId], onDelete: Restrict)
  salary   SalaryRecord? @relation(fields: [salaryId], references: [salaryId], onDelete: SetNull)

  @@index([employeeId])
  @@map("employee_commission")
  @@schema("public")
}

