PORT=3001

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase PostgreSQL Connection URL (Direct: port 5432, Transaction Pooler: port 6543)
# Retrieve this from Supabase Dashboard > Project Settings > Database
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres"
FRONTEND_URL=http://localhost:3000

# Transactional email (optional — when SMTP_HOST is empty, emails are logged instead of sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Vergo Wear <no-reply@vergowear.com>"
