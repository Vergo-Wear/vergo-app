PORT=3001

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Persistent Nest backend: copy the Session Pooler URL (port 5432) from the
# Supabase Dashboard > Connect panel. Do not use the transaction-pooler URL.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres"
# Prisma migration URL. The Session Pooler URL is suitable on IPv4-only networks.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres"
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=15000
# Supabase may take longer than Prisma's 5-second interactive-transaction
# default during inventory locking and multi-row checkout writes.
DATABASE_TRANSACTION_MAX_WAIT_MS=10000
DATABASE_TRANSACTION_TIMEOUT_MS=20000
FRONTEND_URL=http://localhost:3000

# Transactional email (optional — when SMTP_HOST is empty, emails are logged instead of sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Vergo Wear <no-reply@vergowear.com>"

# Cloudinary (payment receipt storage) - fill in from the Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Hours a bank-transfer customer has to upload their payment receipt
PAYMENT_PROOF_EXPIRY_HOURS=4
